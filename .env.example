# Environment & Application Settings
ENVIRONMENT=development
DEBUG=false
ENABLE_TEST_ENDPOINTS=true
DEFAULT_CONCURRENCY_STRATEGY=atomic_update

# Database Connection Settings
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/loadlab
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/loadlab_test

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
